from pathlib import Path
from mlx_vlm import load, generate

MODEL_ID = "mlx-community/SmolVLM-Instruct-4bit"

_model = None
_processor = None


def load_vision_model():
    global _model, _processor
    if _model is None:
        print(f"[VisualGate] Loading {MODEL_ID}...")
        _model, _processor = load(MODEL_ID)
        print("[VisualGate] Model ready.")
    return _model, _processor


def describe_image(image_path: str, max_tokens: int = 40) -> str:
    path = Path(image_path)

    if not path.exists():
        raise FileNotFoundError(f"Image not found: {path}")

    if path.stat().st_size == 0:
        raise ValueError(f"Image is empty: {path}")

    model, processor = load_vision_model()

    prompt = (
        "<image> Describe the visible image in factual concrete terms. "
        "State the main subject, important objects, environment, and visible material. "
        "If it visibly appears to be a sculpture, artifact, ruin, landscape, person, flag, document, or building, say so. "
        "Do not identify a specific place or culture unless it is visually certain."
    )

    result = generate(
        model,
        processor,
        prompt,
        image=str(path),
        verbose=False,
        max_tokens=max_tokens,
    )

    return result.strip()


if __name__ == "__main__":
    import sys

    if len(sys.argv) != 2:
        raise SystemExit(
            "Usage: python -m engine.visual_relevance IMAGE_PATH"
        )

    print(describe_image(sys.argv[1]))
